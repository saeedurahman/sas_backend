# Copy to .env (never commit .env). All values below are placeholders.

# --- Environment -------------------------------------------------------------
# development | production. In production, startup fails on weak/default JWT
# secrets (<32 chars), empty ALLOWED_ORIGINS, DEBUG=true or RATE_LIMIT_ENABLED=false,
# and /docs, /redoc, /openapi.json are disabled.
ENV=development
DEBUG=false

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@localhost:5432/<db_name>

# --- JWT ---------------------------------------------------------------------
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8
REFRESH_TOKEN_EXPIRE_DAYS=30
PIN_TOKEN_EXPIRE_HOURS=12
# A retry with the refresh token that was just rotated gets the same new pair back
# within this many seconds (lost response / double submit). 0 disables.
REFRESH_GRACE_SECONDS=30

# --- Login lockout -----------------------------------------------------------
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
# true = password login must send business_slug
LOGIN_REQUIRE_BUSINESS_SLUG=false

# --- App ---------------------------------------------------------------------
APP_NAME=POS SaaS
API_V1_PREFIX=/api/v1
# Comma-separated origins, e.g. https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000
LOG_LEVEL=INFO
MAX_REQUEST_BODY_BYTES=2097152
# true only behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_FORWARDED_FOR=false
# Database connection pool (a busy pool answers 503 + Retry-After instead of 500)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=10

# --- Rate limiting ("<count>/<second|minute|hour|day>") ------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_IP=10/minute
RATE_LIMIT_LOGIN_ACCOUNT=10/minute
RATE_LIMIT_PIN_IP=30/minute
RATE_LIMIT_PIN_USER=5/minute
RATE_LIMIT_REFRESH_IP=30/minute
RATE_LIMIT_REGISTER_IP=3/hour
RATE_LIMIT_PIN_CHANGE_USER=5/minute
RATE_LIMIT_PASSWORD_CHANGE_USER=5/minute
RATE_LIMIT_CHECK_ALERTS_USER=6/minute

# --- Registration bot protection (disabled by default) -----------------------
REGISTRATION_CAPTCHA_ENABLED=false
# Cloudflare Turnstile default; hCaptcha / reCAPTCHA siteverify URLs also work
CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
CAPTCHA_SECRET=

# --- Subscription (every business gets every feature; only time/status gate access) ----
# Free trial length for new registrations.
TRIAL_DAYS=14
# Days after subscription_ends_at the app stays usable read-only (GET only; writes get
# HTTP 402 "subscription_grace_readonly"). After that every call is 402 "subscription_expired".
GRACE_DAYS=3

# --- Platform admin (owner's web panel at /platform/*) ------------------------
# Signs admin JWTs. MUST differ from JWT_SECRET_KEY / JWT_REFRESH_SECRET_KEY.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Empty = the /platform API answers 503 (disabled).
PLATFORM_JWT_SECRET=
PLATFORM_TOKEN_EXPIRE_MINUTES=60
PLATFORM_MAX_LOGIN_ATTEMPTS=5
PLATFORM_LOCKOUT_MINUTES=30
# Comma-separated key=rate overrides. Keys: login_ip, login_account, api.
# Defaults: login_ip=10/minute,login_account=5/minute,api=300/minute
PLATFORM_ADMIN_RATE_LIMITS=
# Public GET /licenses/revocations
RATE_LIMIT_LICENSE_REVOCATIONS=60/minute

# --- License signing (one-time/offline edition) --------------------------------
# Generate both with: python scripts/generate_license_keypair.py
# The private key lives ONLY in the server environment. The public key is embedded in
# the offline app. Set both or neither.
LICENSE_SIGNING_PRIVATE_KEY=
LICENSE_PUBLIC_KEY=
